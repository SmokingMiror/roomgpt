# Replicate API Key for AI room generation
REPLICATE_API_KEY=your_replicate_api_key_here

# Bytescale API Key for image upload (optional, defaults to free tier)
NEXT_PUBLIC_UPLOAD_API_KEY=your_bytescale_api_key_here

# Upstash Redis URL for rate limiting (optional)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# OpenAI API Key for renovation analysis and reporting
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use for analysis (options: gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini